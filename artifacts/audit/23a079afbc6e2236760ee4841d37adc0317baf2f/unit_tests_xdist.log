    @pytest.mark.asyncio
    async def test_retry_eventually_succeeds() -> None:
        """Fails twice, succeeds on third attempt."""
        call_log: list[int] = []
    
        async def fail_twice(ex: Exchange[Any], ctx: Any) -> None:
            call_log.append(len(call_log) + 1)
            if len(call_log) < 3:
