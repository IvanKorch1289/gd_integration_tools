# ──────────────────────────────────────────────────────────────────────
# .env.example — ТОЛЬКО секреты приложения (с пустыми значениями).
# Сгруппированы по env_prefix; актуальность — `python tools/config_audit.py`.
#
# Правило (ADR-0373): в этом файле — ТОЛЬКО чувствительные значения
# (api_key, password, secret, token, login) и ТОЛЬКО с пустыми значениями.
# URL'ы, имена моделей, хосты, порты, таймауты, флаги и прочие
# несекретные настройки — в config_profiles/{profile}.yml.
# Реальные значения — в Vault (или в окружении стенда), НЕ в репозитории.
#
# Гейт: `python tools/check_env_example.py --secrets-only`
#       (блокирует несекретный ключ и непустое значение секрета).
#
# Активный профиль (APP_PROFILE / APP_ENVIRONMENT) — в
# config_profiles/{profile}.yml и в переменной окружения стенда.
# ──────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────
# Vault
# enabled — управляется через config_profiles/{profile}.yml::vault.enabled.
# Переменная VAULT_ENABLED при наличии работает как override (true/false).
# VAULT_ADDR / VAULT_SECRET_PATH — задаются в config_profiles/*.yml::vault.
# Auth mode: VAULT_TOKEN (static) ИЛИ AppRole (VAULT_ROLE_ID + VAULT_SECRET_ID).
# ──────────────────────────────────────────────────────────────────────
VAULT_TOKEN=
# AppRole auth (альтернатива VAULT_TOKEN). Оба одновременно не задавать.
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ──────────────────────────────────────────────────────────────────────
# Database (DB_*)
# DB_NAME / DB_HOST / DB_PORT — нечувствительные, задаются в
# config_profiles/*.yml::database.
# ──────────────────────────────────────────────────────────────────────
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# External Databases (EXT_DB_<PROFILE>_*)
# Per-connection secrets — формат: EXT_DB_<PROFILE_NAME>_USERNAME / _PASSWORD
# Пример для профилей oracle_1 / pg_1:
#   EXT_DB_ORACLE_1_USERNAME=
#   EXT_DB_ORACLE_1_PASSWORD=
#   EXT_DB_PG_1_USERNAME=
#   EXT_DB_PG_1_PASSWORD=
# ──────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────
# Mongo (MONGO_*)
# ──────────────────────────────────────────────────────────────────────
MONGO_USERNAME=
MONGO_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Redis (REDIS_*) — обычный и sentinel
# ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# RabbitMQ / Queue (QUEUE_*)
# ──────────────────────────────────────────────────────────────────────
QUEUE_USERNAME=
QUEUE_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# MQTT (MQTT_*)
# ──────────────────────────────────────────────────────────────────────
MQTT_USERNAME=
MQTT_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Mail / SMTP (MAIL_*)
# ──────────────────────────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# File Storage (FS_*) — S3/MinIO credentials
# ──────────────────────────────────────────────────────────────────────
FS_ACCESS_KEY=
FS_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────
# Elasticsearch (ES_*)
# ──────────────────────────────────────────────────────────────────────
ES_API_KEY=
ES_USERNAME=
ES_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# ClickHouse (CLICKHOUSE_*)
# ──────────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# HTTP client certs (HTTP_*)
# ──────────────────────────────────────────────────────────────────────
HTTP_CLIENT_CERT_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# InfluxDB (INFLUXDB_*)
# ──────────────────────────────────────────────────────────────────────
INFLUXDB_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# AI providers — только api_key. URL/модели/таймауты — в base.yml.
# Внешние ключи (без Settings-класса): HUGGINGFACE_, PERPLEXITY_,
# OPEN_WEBUI_, OPENROUTER_, NIM_, OPENAI_, GIGACHAT_, SALUTE_SPEECH_.
# ──────────────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=
PERPLEXITY_API_KEY=
OPEN_WEBUI_API_KEY=
OPENROUTER_API_KEY=
NIM_API_KEY=
OPENAI_API_KEY=
# GigaChat credentials: OAuth2 client_id:client_secret либо API-key.
GIGACHAT_CREDENTIALS=
# SaluteSpeech credentials: OAuth2 client_id:client_secret.
SALUTE_SPEECH_CREDENTIALS=
# ADR-0378: ключи провайдеров, читаемые напрямую из os.environ
# (без Settings-модели) — services/ai/ai_providers/{claude,gemini}.py.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ADR-0378: Lakera Guard API-token (fail-closed, если не задан) —
# services/ai/guardrails/lakera_client.py.
LAKERA_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# AI aggregate (AI_*) — общие креды AI-провайдеров.
# ──────────────────────────────────────────────────────────────────────
AI_API_KEY=
AI_PASSWORD=
AI_USERNAME=

# ──────────────────────────────────────────────────────────────────────
# MiniMax (MINIMAX_*) — отдельный провайдер с собственными кредами.
# ──────────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_PASSWORD=
MINIMAX_USERNAME=

# ──────────────────────────────────────────────────────────────────────
# YandexGPT (YANDEXGPT_*) — API-key либо IAM-token.
# ──────────────────────────────────────────────────────────────────────
YANDEXGPT_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# RAG (RAG_*)
# ──────────────────────────────────────────────────────────────────────
RAG_QDRANT_API_KEY=
RAG_EMBEDDING_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# External APIs
# ──────────────────────────────────────────────────────────────────────
SKB_API_KEY=
DADATA_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Security (SEC_*)
# ──────────────────────────────────────────────────────────────────────
SEC_SECRET_KEY=
SEC_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Bot integrations
# ──────────────────────────────────────────────────────────────────────
EXPRESS_SIGNATURE_SECRET=
EXPRESS_SECRET_KEY=
TELEGRAM_SIGNATURE_SECRET=
TELEGRAM_SECRET_KEY=
# ADR-0378: bot-token Telegram, читается напрямую из os.environ —
# services/ops/notification_adapters.py.
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Neo4j (DSL storage processor) — ADR-0378: читается напрямую из
# os.environ — dsl/engine/processors/storage_ext.py.
# NEO4J_URI / NEO4J_USER — несекретные (хост/логин), в YAML профиля.
# ──────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Audit (AUDIT_*) — ключ tamper-evident audit chain.
# ──────────────────────────────────────────────────────────────────────
AUDIT_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────
# Sandbox / notebooks (E2B_*)
# ──────────────────────────────────────────────────────────────────────
E2B_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# JupyterHub (JUPYTER_HUB_*)
# ──────────────────────────────────────────────────────────────────────
JUPYTER_HUB_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Langfuse (LANGFUSE_*) — observability для LLM.
# ──────────────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────
# LDAP (LDAP_*) — service-account credentials.
# ──────────────────────────────────────────────────────────────────────
LDAP_BIND_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Lineage (LINEAGE_*) — data lineage service.
# ──────────────────────────────────────────────────────────────────────
LINEAGE_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Slack notifications (SLACK_*) — fallback channel для Express Chain
# (infrastructure/resilience/components/express_chain.py::slack_fallback).
# Обязателен, если активирован express_chain.slack_fallback.
# ──────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# === MCP servers (Sprint 37 W1 — Context7 для Kimi/Claude) ===
# Context7 API key — для MCP-сервера @upstash/context7-mcp (docs lookup).
# Получить: https://context7.com/dashboard
# Формат: ctx7sk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CONTEXT7_API_KEY=
