      "minimum": 0,
      "default": 0
    },
    "name": {
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gd-integration-tools/schemas/processors/core/dead_letter/1.0.0",
  "title": "DeadLetterProcessor",
  "x-gd-capabilities": [
    "dsl.eip.dead_letter",
    "dsl.dlq.write"
  ],
  "x-gd-tags": [
    "eip",
    "reliability",
    "dlq"
  ]
